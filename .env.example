# Copy to .env.local. Never commit real values.

# Admin
ADMIN_PASSWORD=
AUTH_SECRET=

# Storage — Postgres on the VPS. Older Redis/Blob fallbacks still work without it.
DATABASE_URL=postgres://user:password@host:5432/amarpara

# SMS OTP — Combirds (sms.combirds.com). Server-side only, never NEXT_PUBLIC_.
COMBIRDS_API_KEY=cb_sms_v1_xxxxxxxxxxxxxxxxxxxxxxxx
COMBIRDS_SENDER_ID=ECLTFY
COMBIRDS_TEMPLATE_ID=1077283460037519774
# 32 random bytes as hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=
